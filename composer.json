{
    "name": "toshkq93/laravel-boundaries",
    "description": "Modular monolith for Laravel with enforced module boundaries: modules with their own service providers, declared dependencies and a public API.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "modules",
        "modular-monolith",
        "modular",
        "boundaries",
        "architecture",
        "ddd",
        "bounded-context"
    ],
    "homepage": "https://github.com/toshkq93/laravel-boundaries",
    "authors": [
        {
            "name": "toshkq93",
            "homepage": "https://github.com/toshkq93"
        }
    ],
    "support": {
        "issues": "https://github.com/toshkq93/laravel-boundaries/issues",
        "source": "https://github.com/toshkq93/laravel-boundaries"
    },
    "require": {
        "php": "^8.2",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/filesystem": "^11.0|^12.0|^13.0",
        "illuminate/routing": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.15",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^9.6|^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Toshkq93\\Boundaries\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Toshkq93\\Boundaries\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Toshkq93\\Boundaries\\BoundariesServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G",
        "format": "pint"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
